                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Factory cards",
      "description": "Each card is one problem for one agent. A deep-analysis card (below_minimum) opens when an agent is below a minimum two days running.",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "garden-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select last_seen_at as \"Last seen\", agent as \"Agent\", title as \"Problem\", status as \"Status\", signals as \"Cases\", coalesce(last_outcome, '') as \"Last attempt\", pr_url from factory_cards order by (status in ('open', 'in-progress')) desc, last_seen_at desc"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "pr_url"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Pull request"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open the pull request",
                    "url": "${__value.raw}",
                    "targetBlank": true
                  }
                ]
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": ".+",
                      "result": {
                        "text": "Pull request",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 14,
      "type": "table",
      "title": "Scheduled jobs, latest 100 (Trigger.dev)",
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "garden-trigger"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "garden-trigger"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/v1/runs",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "page[size]",
                "value": "100"
              }
            ]
