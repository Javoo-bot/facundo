NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # dashboard uses anon key + user JWT via cookies; RLS enforces authenticated
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=         # PostHog project API key. Unset = PostHog fully no-ops (normal for local dev).
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com   # EU region — this is EU customer data. Defaults to this if unset.
NEXT_PUBLIC_POSTHOG_EXCLUDED_EMAILS=   # comma-separated internal emails opted out of PostHog entirely (no replay, no events).
                                        # Unset = exclude nobody. Replay is separately off on localhost/staging (lib/analytics.ts).
POSTHOG_PROJECT_TOKEN=            # SERVER-SIDE sink (lib/serverAnalytics.ts, wired via instrumentation.ts): mirrors every
                                   # lib/monitor.ts captureError() call to a PostHog `dashboard_server_error` event. Deliberately
                                   # separate from NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN above (that one is build-time/client-only) —
                                   # can be the same project token. Read at runtime via plain process.env, never NEXT_PUBLIC_.
                                   # Unset = captureError still logs to console.error as before; just no PostHog mirror.
POSTHOG_HOST=https://eu.i.posthog.com   # Same EU-region default as the client-side var. Only matters if POSTHOG_PROJECT_TOKEN is set.
ALLOWED_EMAILS=                  # seed-only: comma-separated emails used to seed the allowed_emails table on first setup.
                                  # Not read at runtime — the table (edited via /settings) is the source of truth. Server-side only, never NEXT_PUBLIC_
SHOPIFY_SHOP=                    # e.g. x.myshopify.com — shop domain for the custom app. Required for lib/shopifyWriteback.ts
                                  # (order status writeback) to do anything; unset = silent no-op. Same value the
                                  # ingest-worker's SHOPIFY_SHOP arms reconcileMissingOrders with.
SHOPIFY_ADMIN_TOKEN=              # Admin API access token (shpat_...) from the custom app; needs read_orders,write_orders
                                  # scopes — PLUS write_fulfillments AND write_merchant_managed_fulfillment_orders
                                  # once Shopify write-back is on in Settings. BOTH are needed: the first lets you
                                  # call the mutations, the second grants access to the fulfillment orders, which are
                                  # assigned to this store's merchant-managed locations. With only the first, reads
                                  # succeed but fulfillmentCreateV2 fails 'api_client does not have access to the
                                  # fulfillment order'. Verified live 2026-09-15.
                                  # Shopify never upgrades an existing token when the requested scopes change: a scope
                                  # change needs a fresh grant via dashboard/scripts/shopify-reauth.sh, which echoes the
                                  # granted scopes back so you can confirm. Server-side only, never NEXT_PUBLIC_.
                                  # Never log this value.
                                  # NOTE: the customer-visible fulfilment writes are NOT env-gated. They ride on
                                  # the SAME Settings switch as the staff-facing writeback
                                  # (app_settings.shopify_writeback_enabled, Settings -> External services), so
                                  # ops can stop them without a deploy. See dashboard/lib/shopifyFulfillment.ts.
INGEST_WORKER_URL=               # Base URL of the ingest worker, e.g. https://facundo-ingest-worker.<sub>.workers.dev
                                  # Powers the admin "Reconcile now" / per-order "Re-pull" controls (lib/ingestWorker.ts).
                                  # Unset → those controls return a 501 "worker URL not set" and stay inert.
OUTBOX_SECRET=                   # Shared secret with the ingest worker (already used worker→dashboard); also authenticates
                                  # the dashboard→worker /reconcile call. Must match the worker's OUTBOX_SECRET. Server-side only.
CX_ALERT_EMAIL=                  # fallback CX alert-sweep recipient (dashboard/lib/cxAlerts.ts) when app_settings.cx_email
                                  # hasn't been set yet via /settings. In test mode alerts always go to test_email instead.

# Outbound email — ALL of it (offers, client notices, CX alerts, recruiting outreach,
# magic links, test email) leaves through lib/email.ts::sendEmail, which picks a
# transport (Resend or Ongage) from EMAIL_TRANSPORT — an EXPLICIT flag
# (lib/emailTransport.ts), not inferred from which secrets below happen to be set.
# Dual-transport by design (2026-08-21): PRODUCTION (v0.2) sets EMAIL_TRANSPORT=resend
# — Resend has a working delivery/open/click webhook (app/api/webhooks/resend/route.ts)
# that Ongage doesn't. STAGING sets EMAIL_TRANSPORT=ongage — its job is just proving the
# send path works end-to-end in QA, so losing tracking there is an acceptable trade (see
# lib/lifecycle.ts's x-email-delivery-feedback-ongage cross-cutting entry).
# Whichever transport is selected, missing ITS OWN secrets fails every send closed with
# a clear error (logged) — never a silent fallback to the other transport.
EMAIL_TRANSPORT=                 # "resend" or "ongage" — REQUIRED, no default. staging: ongage. v0.2/production: resend.

RESEND_API_KEY=                  # Only used when EMAIL_TRANSPORT=resend. Resend dashboard → API Keys. Server-side only, never log.
RESEND_FROM=                     # Optional when EMAIL_TRANSPORT=resend. Default "Facundo <noreply@fc.example.net>"
                                  # (lib/emailFrom.ts). Must stay on the Resend account's verified domain (fc.example.net).

ONGAGE_LIST_ID=                  # Only used when EMAIL_TRANSPORT=ongage. Ongage list id (account default list)
ONGAGE_USERNAME=                 # API user — sent as the X_USERNAME header
ONGAGE_PASSWORD=                 # API password — X_PASSWORD. Server-side only, never log.
ONGAGE_ACCOUNT_CODE=             # X_ACCOUNT_CODE
ONGAGE_SENDING_CONNECTION_ID=    # ESP connection (vendor) id the mail goes out on, e.g. the smtp.com
                                  # "noreply@fc.example.com" connection. The From address MUST be on that
                                  # connection's domain.
ONGAGE_FROM=                     # Optional. Default "Facundo <noreply@fc.example.com>" (lib/emailFrom.ts).

# AI delivery-photo verification gate (lib/photoVerify). Each provider is also
# toggleable at runtime via Settings (app_settings.photo_verify_claude/gemini).
# (ANTHROPIC_API_KEY is no longer used — every LLM call routes through OpenRouter.)
GEMINI_API_KEY=                  # Gemini vision leg (@google/genai). Unset → Gemini abstains; with neither key the verdict is 'review' → the 30% holds for CX.
OPENROUTER_API_KEY=              # SHADOW-MODE opinions via OpenRouter (google/gemini-2.5-pro AND the cheap,
                                  # independent qwen/qwen3-vl-30b-a3b-instruct) — both also see the ordered product's
                                  # reference photo(s), not just text, and each records a 0-100 score for evaluation.
                                  # Never affects verdict/payout. One toggle for both: app_settings.photo_verify_openrouter.
                                  # Unset → neither leg runs (existing Claude/Gemini gate is unaffected).
                                  # ALSO personalises the recruiting outreach email (owner name, researched
                                  # opening, the florist's own language). Unset → every florist gets the
                                  # deterministic catalog render instead; the outreach run still succeeds.
OPENROUTER_RECRUITING_MODEL=     # Optional. Overrides the recruiting personalisation model
                                  # (default anthropic/claude-sonnet-5). A swap is config, not a deploy.

# --- Telnyx (florist SMS) ---
# Auth is a scoped API key (Bearer), not an account-master credential: it is
# independently revocable and rotatable, so a leak here can be cut off without
# disturbing anything else. Create it under the Telnyx portal → API Keys.
#
# TELNYX_SENDER_ID is the alphanumeric brand sender shown to the florist (e.g.
# "Facundo"). Telnyx requires an explicit `from` on every send, so unlike a
# Twilio Messaging Service there is no provider-side per-country sender pick:
# this ONE sender is used for every destination. That is correct for ES/FR/IT/DE
# (all accept alphanumeric senders) but would NOT work in the US/Canada, which
# require a registered 10DLC or toll-free number instead.
#
# Alphanumeric sender IDs need pre-registration in several European countries —
# portal/account setup, not code, and it has lead time. Start it early.
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_SENDER_ID=

# --- Google Places (join-form address autocomplete) ---
# Powers the address field on the public join form (app/florist/accept/[token])
# via the two server-side proxy routes in app/api/places/*. SERVER-SIDE ONLY,
# never NEXT_PUBLIC_ — the browser talks to our routes, not to Google, and both
# routes require a live florist join token before spending the key
# (lib/joinTokenGate.ts).
#
# The account-wide Maps Platform key, with the Places API enabled on it. In the
# GCP console restrict it by API, NOT by HTTP referrer — these calls originate
# from our server, so there is no referrer to check.
#
# Unset -> the routes return `configured: false` and the field degrades to a
# plain text input. The form still works; addresses just aren't map-verified.
GOOGLE_MAPS_API_KEY=

# --- Airwallex (florist payouts, lib/airwallex/*) ---
# AIRWALLEX_BASE defaults to the DEMO host (https://api-demo.airwallex.com);
# AIRWALLEX_CLIENT_ID / AIRWALLEX_API_KEY are the credentials for that host.
# app_settings.payments_live=true with the demo host is REFUSED by
# lib/rails.ts unless the line below is set — a staging-only escape hatch so
# the reveal-and-pay card step can be rehearsed with sandbox cards (no money).
# NEVER set this on production. Test/demo shops still always get the ledger.
# AIRWALLEX_ALLOW_DEMO_LIVE=1
