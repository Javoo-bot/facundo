    "i18n-iso-countries": "^7.14.0",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.10",
    "lucide-react": "^1.24.0",
    "next": "^15.0.0",
    "posthog-js": "1.402.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "tz-lookup": "^6.1.25",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
