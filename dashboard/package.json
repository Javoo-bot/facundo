{
  "name": "facundo-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node scripts/tests.mjs",
    "sync:match": "node scripts/sync-match.mjs",
    "cf:build": "opennextjs-cloudflare build && rm -rf .open-next.nosync && mv .open-next .open-next.nosync && ln -s .open-next.nosync .open-next",
