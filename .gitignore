# Env / secrets
.env
.env.local
*.local

# Python
__pycache__/
*.py[cod]
.venv/
.uv/
uv.lock

# Node / Next.js
node_modules/
.next/
out/
next-env.d.ts
npm-debug.log*

# OS / editor
.DS_Store
.vscode/
.idea/

# TypeScript build cache
*.tsbuildinfo
.env.*
!.env*.example

# Visual brainstorm companion (local mockups)
.superpowers/

# Claude Code local dir (settings, worktrees, jobs). Ignore the CONTENTS rather
# than the directory itself, so the shared team skills below can be re-included
# — git cannot un-ignore a path whose parent directory is excluded.
.claude/*
!.claude/skills/
!.claude/rules/

# Supabase CLI local state
supabase/.temp/
.worktrees/

# Prod data dumps from scripts/clone-prod-to-staging.sh — contains real customer PII
.clone-tmp/

.claude/settings.local.json

# Screen recordings stay local, never committed
*.webm
*.mp4
*.mov
# ...except the curated README videos
!docs/media/*.mp4
